{
  "manifest_version": 3,
  "name": "ChatGPTExporter for Firefox and Zen",
  "version": "0.1.6",
  "description": "Resumable local ChatGPT exports through the ConversationExporters native host.",
  "permissions": ["alarms", "nativeMessaging", "storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "scripts": ["service-worker.js"] },
  "action": { "default_title": "Open ChatGPTExporter" },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-exporter@conversation-exporters.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["personalCommunications", "websiteContent"] }
    }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" },
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*"], "js": ["page-bridge.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://chatgpt.com/*"], "js": ["content-relay.js"], "run_at": "document_start" }
  ]
}
