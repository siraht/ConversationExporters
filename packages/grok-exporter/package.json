{
  "name": "grok-exporter",
  "version": "0.1.0",
  "private": true,
  "description": "A complete, resumable, privacy-first exporter for Grok web conversations.",
  "type": "module",
  "scripts": {
    "audit:private": "node scripts/audit-private-archive.mjs",
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build-firefox.mjs",
    "check": "npm run typecheck && npm test && npm run privacy:check && npm run build",
    "package": "node scripts/package.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/test-extension.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@conversation-exporters/shared": "0.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "playwright": "^1.54.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
