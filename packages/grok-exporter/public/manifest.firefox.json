{
  "manifest_version": 3,
  "name": "GrokExporter for Firefox and Zen",
  "version": "0.1.0",
  "description": "Resumable local Grok exports through the ConversationExporters native host.",
  "permissions": ["alarms", "nativeMessaging", "storage", "tabs", "unlimitedStorage"],
  "host_permissions": [
    "https://grok.com/*",
    "https://assets.grok.com/*",
    "https://imagine-public.x.ai/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "background": { "scripts": ["service-worker.js"] },
  "action": { "default_title": "Open GrokExporter" },
  "browser_specific_settings": {
    "gecko": {
      "id": "grok-exporter@conversation-exporters.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["personalCommunications", "websiteContent"] }
    }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" },
  "content_scripts": [
    { "matches": ["https://grok.com/*"], "js": ["page-bridge.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://grok.com/*"], "js": ["content-relay.js"], "run_at": "document_start" }
  ]
}
