{
  "name": "conversation-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Idempotent local ingestion and Flywheel replication for conversation exports.",
  "type": "module",
  "bin": {
    "conversation-sync": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "install:native": "sh scripts/install-native-host.sh",
    "install:systemd": "sh scripts/install-systemd.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.54.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
