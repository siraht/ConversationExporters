[Unit]
Description=Run automatic ChatGPT and Grok exporter dashboards
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/ConversationExporters
ExecStart=/usr/bin/env DISPLAY=:0 XAUTHORITY=%h/.Xauthority /usr/bin/node %h/Projects/ConversationExporters/packages/sync-runner/dist/cli.js extensions --interval 3600
Restart=on-failure
RestartSec=30
UMask=0077

[Install]
WantedBy=default.target
