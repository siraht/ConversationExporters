{
  "manifest_version": 3,
  "name": "GrokExporter",
  "version": "0.1.0",
  "description": "Complete, resumable, privacy-first local exports of your Grok conversation history.",
  "permissions": ["storage", "tabs", "unlimitedStorage"],
  "host_permissions": [
    "https://grok.com/*",
    "https://assets.grok.com/*",
    "https://imagine-public.x.ai/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open GrokExporter"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "content_scripts": [
    {
      "matches": ["https://grok.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://grok.com/*"],
      "js": ["content-relay.js"],
      "run_at": "document_start"
    }
  ]
}
